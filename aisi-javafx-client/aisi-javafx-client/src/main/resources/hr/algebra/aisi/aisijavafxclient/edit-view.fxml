<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hr.algebra.aisi.aisijavafxclient.EditController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>
    <Label text="Edit Netflix Show"/>
    <TextField fx:id="titleField" promptText="Title"/>
    <ComboBox fx:id="showTypeCombo" promptText="Type"/>
    <TextField fx:id="directorField" promptText="Director"/>
    <TextField fx:id="castMembersField" promptText="Cast members"/>
    <TextField fx:id="countryField" promptText="Country"/>
    <TextField fx:id="dateAddedField" promptText="Date added (YYYY-MM-DD)"/>
    <TextField fx:id="releaseYearField" promptText="Release year"/>
    <TextField fx:id="ratingField" promptText="Rating"/>
    <TextField fx:id="durationField" promptText="Duration"/>
    <TextField fx:id="listedInField" promptText="Listed in"/>
    <TextArea fx:id="descriptionArea" promptText="Description" prefRowCount="3"/>
    <HBox spacing="10.0">
        <Button text="Save" onAction="#onSaveButtonClick"/>
        <Button text="Back" onAction="#onBackButtonClick"/>
    </HBox>
</VBox>